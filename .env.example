# 项目结算资料管理 — 环境变量模板
# 拷贝本文件为 .env 后按需修改；.env 在 .gitignore，不入仓
#
# v0.3.1+ 公网部署：以下 4 个 secret 必填，缺一启动 fail-fast
# dev 默认值已就位（scripts/docker-up.bat 自动 bootstrap）

# 管理员用户名（单用户系统，目前只有 admin）
ADMIN_USERNAME=admin

# 管理员密码（明文，启动时自动 bcrypt 化；生产建议替换为 bcrypt 哈希）
#   生成：python -c "from passlib.hash import bcrypt; import sys; print(bcrypt.hash(sys.argv[1]))" YOUR_PASSWORD
ADMIN_PASSWORD=admin123

# 站点验证码（4-32 字符，登录时三件套之一；强随机化）
SITE_VERIFICATION_CODE=jrvUPovFZS8

# JWT 签名密钥（≥32 字符强随机；泄漏即伪造登录）
#   生成：python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=WnPJxwlsJEs4btOVhGOdeIgzvomHD-NPgPBC1Nebt_sqV72bfuqDDSWzR5WM6RLW

# Token 过期小时数（公网部署 12h 上限；内网可放宽）
JWT_EXPIRE_HOURS=12

# CORS 允许来源（JSON 列表；公网部署时把 YOUR_PUBLIC_IP 换成实际 IP）
CORS_ORIGINS=["http://localhost","http://localhost:18080","http://127.0.0.1","http://127.0.0.1:18080","http://localhost:5173"]

# 访问日志（公网部署建议 true 便于审计）
ACCESS_LOG=true
